pkgname=libcamera-apollo
pkgver=0.7.2
pkgrel=3
pkgdesc='libcamera with Apollo camera tuning and software ISP autofocus'
arch=(aarch64)
url='https://github.com/royka1/Xiaomi-Apollo-pmOS-packages'
license=(LGPL-2.1-or-later GPL-2.0-or-later BSD-2-Clause)
depends=(glibc gnutls libyaml libyuv libunwind libdrm libevent libjpeg-turbo
         libtiff libgcc libstdc++ systemd-libs qt6-base glib2 gstreamer gst-plugins-base-libs)
makedepends=(meson ninja gcc pkgconf python-jinja python-ply python-yaml qt6-tools)
provides=("libcamera=$pkgver" "libcamera-ipa=$pkgver" "libcamera-tools=$pkgver"
          "gst-plugin-libcamera=$pkgver" 'libcamera.so=0.7-64' 'libcamera-base.so=0.7-64')
conflicts=(libcamera libcamera-ipa libcamera-tools gst-plugin-libcamera)
# IPA signatures cover the installed binary bytes. Do not strip after signing.
options=(!strip !lto)
source=("https://gitlab.freedesktop.org/camera/libcamera/-/archive/v$pkgver/libcamera-v$pkgver.tar.gz"
        0001-libcamera-simple-Enable-softISP-for-the-Pinephone.patch
        0002-libcamera-simple-Skip-hwISP-formats-if-swISP-is-acti.patch
        0003-libcamera-Add-support-for-the-OmniVision-OV13B10.patch
        0004-libcamera-software-ISP-contrast-based-autofocus.patch
        0005-libcamera-Add-support-for-the-Sony-IMX682.patch
        s5khmx.yaml ov13b10.yaml s5k3t2.yaml s5k5e9.yaml qcam.desktop
        0006-libipa-add-apollo-samsung-gain-helpers.patch apollo-gain-test.cpp
        0007-software-isp-release-egl-context.patch)
