prepare() {
  cd "libcamera-v$pkgver"
  for file in "$srcdir"/*.patch; do patch -Np1 --fuzz=0 < "$file"; done
}

build() {
  meson setup "libcamera-v$pkgver" build --prefix=/usr --libdir=lib \
    --libexecdir=lib --buildtype=release -Db_lto=false -Dwerror=false \
    -Dpipelines=simple -Dipas=simple -Dcam=enabled -Dqcam=enabled \
    -Dgstreamer=enabled -Dv4l2=enabled -Dpycamera=disabled \
    -Ddocumentation=disabled -Dtest=false -Dlc-compliance=disabled
  meson compile -C build -j 8
}

check() {
  g++ -std=c++17 -Ilibcamera-v$pkgver/src/ipa/libipa \
    -Ilibcamera-v$pkgver/include -Ibuild/include \
    apollo-gain-test.cpp build/src/ipa/libipa/libipa.a \
    -Lbuild/src/libcamera/base -lcamera-base -o apollo-gain-test
  LD_LIBRARY_PATH="$srcdir/build/src/libcamera/base" ./apollo-gain-test
}

package() {
  DESTDIR="$pkgdir" meson install -C build --no-rebuild
  install -Dm644 -t "$pkgdir/usr/share/libcamera/ipa/simple" \
    "$srcdir"/{s5khmx,ov13b10,s5k3t2,s5k5e9}.yaml
  install -Dm644 "$srcdir/qcam.desktop" "$pkgdir/usr/share/applications/qcam.desktop"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    "libcamera-v$pkgver"/LICENSES/{BSD-2-Clause,LGPL-2.1-or-later,GPL-2.0-or-later}.txt
}
