 {
+    /* Apply the final activation state of the compositor's event batch.
+     * Surrounding-text updates alone must not undo a manual hide request. */
+    if (!im_pending_update)
+        return;
+    im_active = im_pending_active;
+    im_pending_update = false;
+    if (im_active)
+        show();
+    else
+        hide();
 }
 
