+static void
+lock_locked(void *data, struct hyprland_lock_notification_v1 *notification)
+{
+    session_locked = true;
+    if (keyboard.vkbd) {
+        struct timespec now = {0};
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        uint32_t time = (uint64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+        if (layer_surface)
+            kbd_release_key(&keyboard, time);
+        const uint32_t masks[] = {Shift, CapsLock, Ctrl, Alt, Super, AltGr};
+        const uint32_t keys[] = {KEY_LEFTSHIFT, KEY_CAPSLOCK, KEY_LEFTCTRL,
+                                 KEY_LEFTALT, KEY_LEFTMETA, KEY_RIGHTALT};
+        for (unsigned i = 0; i < sizeof(masks) / sizeof(masks[0]); ++i)
+            if (keyboard.mods & masks[i])
+                zwp_virtual_keyboard_v1_key(keyboard.vkbd, time, keys[i],
+                                            WL_KEYBOARD_KEY_STATE_RELEASED);
+        keyboard.mods = 0;
+        keyboard.compose = 0;
+        zwp_virtual_keyboard_v1_modifiers(keyboard.vkbd, 0, 0, 0, 0);
+    }
+    cur_press = false;
+    hide();
+}
+
+static void
+lock_unlocked(void *data, struct hyprland_lock_notification_v1 *notification)
+{
+    session_locked = false;
+    if (im_auto && im_active)
+        show();
+}
