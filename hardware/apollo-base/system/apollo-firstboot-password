#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Password entry happens locally on the phone; never put it in arguments/logs.
set -euo pipefail
[[ $EUID == 0 && ${SUDO_USER:-} == apollo ]]
test -e /run/apollo-persistent
test -f /etc/apollo/firstboot-needed
owner_uid=$(id -u apollo)
wayland_socket=
for candidate in /run/user/"$owner_uid"/wayland-*; do
  [[ -S $candidate ]] || continue
  [[ -z $wayland_socket ]] || exit 1
  wayland_socket=${candidate##*/}
done
[[ -n $wayland_socket ]]
dialog() {
  runuser -u apollo -- env XDG_RUNTIME_DIR="/run/user/$owner_uid" \
    WAYLAND_DISPLAY="$wayland_socket" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$owner_uid/bus" \
    kdialog --title 'Apollo Linux: configuración inicial' "$@"
}
while true; do
  first=$(dialog --password 'Crea una contraseña local de al menos 12 caracteres. No se envía fuera del móvil.') || exit 1
  if [[ ${#first} -lt 12 || $first == *$'\n'* || $first == *$'\r'* ]]; then
    unset first
    dialog --error 'Usa al menos 12 caracteres y una sola línea.'
    continue
  fi
  second=$(dialog --password 'Repite la contraseña para confirmarla.') || { unset first; exit 1; }
  if [[ $first != "$second" ]]; then
    unset first second
    dialog --error 'Las contraseñas no coinciden.'
    continue
  fi
  printf 'apollo:%s\n' "$first" | chpasswd
  unset first second
  rm -f /etc/apollo/firstboot-needed /etc/sudoers.d/apollo-firstboot
  dialog --msgbox 'Contraseña local configurada. Ya puedes administrar el sistema con sudo.'
  break
done
