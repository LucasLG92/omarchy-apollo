pkgname=apollo-modem
pkgver=1.0
pkgrel=4
pkgdesc='Apollo SDX55 firmware and userspace services, with RAM-only EFS test mode'
arch=(aarch64)
url='https://github.com/royka1/Xiaomi-Apollo-pmOS-packages'
license=(GPL-2.0-only BSD-3-Clause LicenseRef-proprietary)
depends=(glibc glib2 libqrtr-glib apollo-qcom-core pd-mapper-apollo modemmanager-apollo libqmi util-linux systemd zstd)
makedepends=(gcc linux-api-headers pkgconf)
options=(!strip)
source=(
  pm_service_native.c
  mdm_helper_native.c
  mhi_efs_sync.c
  diag_reader.c
  adsp_diag.c
  pm-service-native.service
  mdm-helper-native.service
  mhi-efs-sync.service
  adsp-diag.service
  tqftpserv.c
  translate.c
  zstd-decompress.c
  list.h
  translate.h
  zstd-decompress.h
  tqftpserv-sdx55.service
  apollo-efs-extract
  apollo-efs-extract.service
  apollo-uim-provision
  77-mm-ignore-sdx55-efs.rules
  77-mm-sdx55-fusion.rules
  rmnet.conf
  apollo-modem-fw-1.0.tar.gz
  apollo-modem-start.service
  10-apollo-modem-ordering.conf
  apollo-modem-rproc.service apollo-modem-power-on zz-apollo-multiplex.conf
  20-apollo-manual-power.conf)
