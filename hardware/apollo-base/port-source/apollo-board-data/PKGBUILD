depends=(alsa-ucm-conf systemd linux-firmware-qcom wireplumber)
options=(!strip)
source=(apollo-voice-cal-1.0.tar.gz HiFi.conf VoiceCall.conf Xiaomi-Mi-10T.conf
        ath11k-wow.conf apollo-suspend-heal 81-libssc-xiaomi-apollo.rules 51-apollo-pcm-format.conf)
