package() {
  install -d "$pkgdir/usr/lib/firmware/qcom"
  cp -a qcom/. "$pkgdir/usr/lib/firmware/qcom/"
  install -d "$pkgdir/usr/lib/firmware/postmarketos"
  ln -s ../qcom/vpu-1.0/venus.mbn "$pkgdir/usr/lib/firmware/postmarketos/venus.mbn"
  local ucm="$pkgdir/usr/share/alsa/ucm2"
  install -Dm644 HiFi.conf "$ucm/Xiaomi-Mi-10T/HiFi.conf"
  install -Dm644 VoiceCall.conf "$ucm/Xiaomi-Mi-10T/VoiceCall.conf"
  install -Dm644 Xiaomi-Mi-10T.conf "$ucm/Xiaomi-Mi-10T/Xiaomi Mi 10T.conf"
  install -d "$ucm/conf.d/sm8250"
  ln -s '../../Xiaomi-Mi-10T/Xiaomi Mi 10T.conf' "$ucm/conf.d/sm8250/X10T.conf"
  ln -s '../../Xiaomi-Mi-10T/Xiaomi Mi 10T.conf' "$ucm/conf.d/sm8250/Xiaomi Mi 10T.conf"
  install -Dm644 ath11k-wow.conf "$pkgdir/usr/lib/modprobe.d/ath11k-wow.conf"
  install -Dm755 apollo-suspend-heal "$pkgdir/usr/lib/systemd/system-sleep/apollo-suspend-heal"
  install -Dm644 81-libssc-xiaomi-apollo.rules "$pkgdir/usr/lib/udev/rules.d/81-libssc-xiaomi-apollo.rules"
  install -Dm644 51-apollo-pcm-format.conf "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/51-apollo-pcm-format.conf"
}
