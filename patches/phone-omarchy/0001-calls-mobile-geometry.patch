 cui-keypad .letters { font-size: 70%; }
@@ -35,3 +36,63 @@
 #cui_call_buttons {
   font-size: 10pt;
 }
+
+/* Apollo mobile visual candidate: LGPL-2.1-or-later additional style fragment.
+ * Inherit libadwaita's semantic colors, as Omarchy's GNOME theme integration
+ * already selects its light/dark mode. Do not pin a provider/theme palette.
+ * Keep destructive, error, selection and high-contrast semantics upstream.
+ */
+
+window cui-dialpad .phone-number-entry {
+  font-size: 22px;
+  font-feature-settings: "tnum";
+  min-width: 0;
+  min-height: 32px;
+  padding: 8px;
+  border-radius: 0;
+}
+window cui-keypad > grid > button {
+  border-radius: 0;
+  min-width: 40px;
+  min-height: 44px;
+  padding: 4px 8px;
+}
+window cui-keypad > grid > button > box { min-height: 42px; }
+window cui-keypad .digit {
+  font-size: 24px;
+  font-weight: 500;
+  font-feature-settings: "tnum";
+  min-height: 28px;
+}
+window cui-keypad .letters { font-size: 10px; min-height: 12px; opacity: 1; }
+window cui-keypad .symbol { font-size: 24px; }
+window cui-dialpad .dial-button {
+  border-radius: 0;
+  min-height: 44px;
+  padding: 6px 24px;
+}
+window cui-dialpad .delete-button {
+  border-radius: 0;
+  min-width: 44px;
+  min-height: 44px;
+  padding: 0;
+}
+
+@media (prefers-contrast: no-preference) {
+  window cui-keypad .letters { color: var(--window-fg-color); }
+  window cui-dialpad .phone-number-entry {
+    color: var(--accent-color);
+    background: var(--view-bg-color);
+  }
+  window cui-keypad > grid > button {
+    color: var(--window-fg-color);
+    background: var(--card-bg-color);
+    border: 1px solid alpha(var(--window-fg-color), 0.22);
+  }
+  window cui-keypad > grid > button:hover {
+    background: alpha(var(--window-fg-color), 0.08);
+  }
+  window cui-keypad > grid > button:active {
+    background: alpha(var(--accent-bg-color), 0.22);
+  }
+}
