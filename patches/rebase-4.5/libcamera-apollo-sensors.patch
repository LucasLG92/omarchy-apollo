+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <cmath>
+#include <iostream>
+#include "camera_sensor_helper.h"
+using namespace libcamera::ipa;
+int main()
+{
+    for (const char *name : { "s5khmx", "s5k3t2", "s5k5e9", "ov13b10" }) {
+        auto helper = CameraSensorHelperFactoryBase::create(name);
+        if (!helper || helper->blackLevel() != 4096) return 1;
+        const unsigned base = std::string(name) == "ov13b10" ? 128 : 32;
+        for (unsigned multiple : { 1, 2, 4, 8 }) {
+            if (std::abs(helper->gain(base * multiple) - multiple) > 1e-9) return 2;
+            if (helper->gainCode(multiple) != base * multiple) return 3;
+        }
+        std::cout << name << ": gain-code round trips and black level correct\n";
+    }
+    return 0;
+}
