+static int smb5_get_usb_current_now(struct smb5_chip *chip, int *val)
+{
+	int rc, current_uv, current_ua;
+
+	rc = smb5_get_iio_chan(chip, chip->usb_in_i_chan, &current_uv);
+	if (rc < 0)
+		return rc;
+
+	/*
+	 * The existing IIO getter only reports during active USB charging.
+	 * PM8150B USB_IN_I has a 0.2 V/A gain in buck mode: convert the
+	 * processed IIO voltage (uV) to power_supply current (uA).
+	 * This charging-state-gated path does not implement OTG telemetry.
+	 */
+	if (current_uv < 0 || check_mul_overflow(current_uv, 5, &current_ua))
+		return -ERANGE;
+
+	*val = current_ua;
+	return 0;
+}
