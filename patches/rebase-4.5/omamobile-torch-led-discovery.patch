--- /dev/null
+++ b/plugins/omamobile.quicksettings/TorchModel.js
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: MIT
+.pragma library
+
+function statusCommand() {
+  return ["sh", "-c", 'for device in white:torch white:flash; do if brightnessctl --class=leds --device="$device" --machine-readable info 2>/dev/null; then exit 0; fi; done; exit 1']
+}
+
+function parseStatus(text) {
+  var unavailable = { available: false, enabled: false, device: "" }
+  var fields = String(text || "").trim().split(",")
+  if (fields.length !== 5 || fields[1] !== "leds") return unavailable
+  if (fields[0] !== "white:torch" && fields[0] !== "white:flash") return unavailable
+  if (!/^[0-9]+$/.test(fields[2]) || !/^[0-9]+$/.test(fields[4])) return unavailable
+  var current = Number(fields[2]), maximum = Number(fields[4])
+  if (!isFinite(current) || !isFinite(maximum) || maximum <= 0 || current > maximum) return unavailable
+  return { available: true, enabled: current > 0, device: fields[0] }
+}
+
+function writeCommand(device, enabled) {
+  if (device !== "white:torch" && device !== "white:flash") return []
+  return ["brightnessctl", "--class=leds", "--device=" + device, "--quiet", "set", enabled ? "0" : "100%"]
+}
