#!/usr/bin/python3
"""Local first-step password form; stdout is a private pipe to the installer."""
import os
import stat
import sys
import gi
gi.require_version('Gtk','4.0')
from gi.repository import Gtk
gi.require_version('Gdk','4.0')
from gi.repository import Gdk

if os.getuid()!=1001 or not stat.S_ISFIFO(os.fstat(sys.stdout.fileno()).st_mode):
    raise SystemExit('This private dialog is opened by the initial owner setup.')
password=None
application=Gtk.Application(application_id='org.omarchy.Apollo.InitialPassword')

def activate(app):
    Gtk.Settings.get_default().set_property('gtk-application-prefer-dark-theme',True)
    css=Gtk.CssProvider()
    css.load_from_data(b'''
window { background: #1a1b26; color: #c0caf5; }
headerbar { background: #16161e; color: #c0caf5; box-shadow: none; }
passwordentry { background: #24283b; color: #c0caf5; border-radius: 10px; padding: 6px; }
button { border-radius: 10px; }
button.suggested-action { background: #7aa2f7; color: #16161e; font-weight: 700; }
button.suggested-action:disabled { background: #343b58; color: #9aa5ce; }
#validation { color: #e0af68; font-weight: 600; }
#validation.ready { color: #9ece6a; }
''')
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(),css,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    window=Gtk.ApplicationWindow(application=app,title='Paso 1 de 2: contraseña')
    window.set_default_size(400,540)
    header=Gtk.HeaderBar();header.set_title_widget(Gtk.Label(label='Paso 1 de 2'))
    window.set_titlebar(header)
    content=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=16,
        margin_start=24,margin_end=24,margin_top=20,margin_bottom=20)
    heading=Gtk.Label(label='Contraseña de administración',xalign=0,wrap=True)
    heading.add_css_class('title-2');content.append(heading)
    content.append(Gtk.Label(label='Usa al menos 12 caracteres. Sirve para administrar Linux. Después crearás el PIN numérico de la pantalla.',xalign=0,wrap=True))
    first=Gtk.PasswordEntry(show_peek_icon=True,height_request=52,placeholder_text='Mínimo 12 caracteres')
    second=Gtk.PasswordEntry(show_peek_icon=True,height_request=52,placeholder_text='Repite la contraseña')
    counter=Gtk.Label(label='Faltan 12 caracteres',xalign=0,wrap=True)
    counter.set_name('validation')
    content.append(first);content.append(second);content.append(counter)
    actions=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,spacing=12)
    cancel=Gtk.Button(label='Cancelar',height_request=48)
    save=Gtk.Button(label='Guardar contraseña',height_request=48,sensitive=False)
    save.add_css_class('suggested-action')
    def changed(entry):
        value=first.get_text();repeat=second.get_text()
        valid=12<=len(value)<=256 and '\n' not in value and '\r' not in value
        if len(value)<12:message='Faltan '+str(12-len(value))+' caracteres'
        elif not valid:message='Usa entre 12 y 256 caracteres en una sola línea.'
        elif not repeat:message='Repite la contraseña para confirmarla.'
        elif value!=repeat:message='Las contraseñas todavía no coinciden.'
        else:message='Contraseña lista. A continuación crearás el PIN.'
        ready=valid and value==repeat
        counter.set_text(message);save.set_sensitive(ready)
        if ready:counter.add_css_class('ready')
        else:counter.remove_css_class('ready')
    def finish(button):
        global password
        value=first.get_text()
        if not (12<=len(value)<=256 and value==second.get_text() and '\n' not in value and '\r' not in value):return
        password=value;first.set_text('');second.set_text('');app.quit()
    first.connect('changed',changed);second.connect('changed',changed)
    cancel.connect('clicked',lambda button:app.quit());save.connect('clicked',finish)
    actions.append(cancel);actions.append(save);content.append(actions)
    window.set_child(content);window.present();first.grab_focus()

application.connect('activate',activate)
application.run([])
if password is None:raise SystemExit(2)
sys.stdout.write(password+'\n');sys.stdout.flush();password=None
