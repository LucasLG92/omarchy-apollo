#!/bin/bash
# A one-time, local password dialog; secrets never enter arguments or files.
set -euo pipefail
ulimit -c 0
[[ $EUID == 0 && ${SUDO_USER:-} == apollo ]]
[[ -e /run/apollo-persistent ]]
marker=/etc/omarchy-apollo/firstboot-needed
[[ -f $marker && ! -L $marker && $(stat --format='%u:%a' -- "$marker") == 0:600 ]]
owner_uid=$(id -u apollo)
[[ $owner_uid == 1001 ]]
runtime=/run/user/$owner_uid
display=
for candidate in "$runtime"/wayland-*; do
  [[ -S $candidate && ! -L $candidate ]] || continue
  [[ $(stat --format=%u -- "$candidate") == "$owner_uid" && -z $display ]] || exit 1
  display=${candidate##*/}
done
[[ $display =~ ^wayland-[0-9]+$ ]]
as_owner=(runuser -u apollo -- env XDG_RUNTIME_DIR="$runtime"
  WAYLAND_DISPLAY="$display" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus")
dialog() {
  "${as_owner[@]}" zenity --title='Omarchy Apollo: configuración inicial' --width=360 "$@"
}
"${as_owner[@]}" systemctl --user start omarchy-apollo-keyboard.service
"${as_owner[@]}" systemctl --user kill --signal=USR2 --kill-whom=main omarchy-apollo-keyboard.service
while true; do
  if first=$("${as_owner[@]}" /usr/lib/omarchy/apollo/password-dialog); then
    :
  else
    result=$?
    unset first
    # Cancellation leaves the one-time setup available in the launcher.
    [[ $result == 2 ]] && exit 0
    dialog --error --text='No se pudo abrir el formulario. Puedes reintentarlo desde Configurar Omarchy Apollo.'
    exit 1
  fi
  if [[ ${#first} -lt 12 || ${#first} -gt 256 || $first == *$'\n'* || $first == *$'\r'* ]]; then
    unset first
    dialog --error --text='Usa entre 12 y 256 caracteres, en una sola línea.'
    continue
  fi
  if ! printf 'apollo:%s\n' "$first" | /usr/bin/chpasswd; then
    unset first
    dialog --error --text='Linux no ha podido guardar la contraseña. Vuelve a intentarlo; todavía no se ha creado el PIN.'
    continue
  fi
  unset first
  rm -- "$marker" /etc/sudoers.d/omarchy-apollo-firstboot
  "${as_owner[@]}" systemctl --user kill --signal=USR1 --kill-whom=main omarchy-apollo-keyboard.service
  systemctl start --no-block omarchy-apollo-owner-pin-setup.service
  break
done
