#!/bin/bash
# omarchy:summary=Show or hide the Apollo touch keyboard
set -euo pipefail
if systemctl --user is-active --quiet omarchy-apollo-keyboard.service; then
  systemctl --user kill --signal=RTMIN omarchy-apollo-keyboard.service
else
  systemctl --user start omarchy-apollo-keyboard.service
  systemctl --user kill --signal=USR2 omarchy-apollo-keyboard.service
fi
