[Unit]
Description=Refresh Apollo read-only RTC calibration after trusted time synchronization
After=time-sync.target
ConditionPathExists=/sys/class/rtc/rtc0/since_epoch

[Service]
Type=oneshot
ExecStart=/usr/lib/omarchy/apollo/clock calibrate
User=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/omarchy-apollo
CapabilityBoundingSet=
