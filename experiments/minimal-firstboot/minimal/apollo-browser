"""Browser entrypoint compatible with Omarchy's default-browser launcher."""
import os,sys
if os.environ.get('LC_ALL',os.environ.get('LANG','C')) in ('C','POSIX',''):
    os.environ['LC_ALL']='C.UTF-8'
args=[]
for value in sys.argv[1:]:
    if value in ('--incognito','--private','--private-window'):args.append('--incognito-mode')
    elif value.startswith('--app='):args.append(value[6:])
    elif value in ('--new-window','--incognito-mode','--private-instance') or not value.startswith('--'):args.append(value)
    else:raise SystemExit('Unsupported browser option: '+value)
os.execv('/usr/bin/flatpak',['flatpak','run','org.gnome.Epiphany',*args])
