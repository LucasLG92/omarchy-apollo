#!/usr/bin/python3 -I
# SPDX-License-Identifier: MIT
"""Fixed root GUI launcher; pkexec action requires fresh auth_admin."""
from pathlib import Path
import os
import pwd
import re
import resource
import socket
import stat
import struct
import subprocess
import sys

PROGRAM = '/usr/lib/apollo/owner-ui/owner-setup.py'
ENV = {'PATH': '/usr/bin:/bin', 'LANG': 'C.UTF-8', 'LC_ALL': 'C.UTF-8'}


def protected_file(path):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        return False
    for parent in path.parents:
        info = parent.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            return False
    return True


def valid_session(properties, uid):
    return (properties.get('User') == str(uid) and properties.get('Active') == 'yes'
            and properties.get('Remote') == 'no' and properties.get('Type') == 'wayland'
            and properties.get('Class') == 'user')


def session_properties(uid):
    session = subprocess.check_output(['/usr/bin/loginctl', 'show-user', str(uid), '--property=Display', '--value'],
                                      env=ENV, stderr=subprocess.DEVNULL, timeout=5).decode('ascii').strip()
    if not re.fullmatch('[A-Za-z0-9_-]{1,64}', session):
        raise PermissionError('Owner session is unavailable')
    raw = subprocess.check_output(['/usr/bin/loginctl', 'show-session', session,
                                   '--property=User', '--property=Active', '--property=Remote',
                                   '--property=Type', '--property=Class', '--no-pager'],
                                  env=ENV, stderr=subprocess.DEVNULL, timeout=5).decode('ascii')
    properties = dict(line.split('=', 1) for line in raw.splitlines() if '=' in line)
    if not valid_session(properties, uid):
        raise PermissionError('An active local owner Wayland session is required')
    return properties


def owner_display(uid):
    session_properties(uid)
    runtime = Path('/run/user') / str(uid)
    info = runtime.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid or info.st_mode & 0o077:
        raise PermissionError('Owner runtime directory is invalid')
    candidates = []
    for path in runtime.glob('wayland-*'):
        info = path.lstat()
        if re.fullmatch('wayland-[0-9]{1,4}', path.name) and stat.S_ISSOCK(info.st_mode) and info.st_uid == uid:
            candidates.append(path)
    if len(candidates) != 1:
        raise PermissionError('A unique owner compositor is required')
    display = candidates[0]
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(2)
        connection.connect(str(display))
        pid, peer_uid, _ = struct.unpack('3i', connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize('3i')))
    if peer_uid != uid or pid <= 0:
        raise PermissionError('Compositor peer does not match the owner')
    executable = Path(os.readlink('/proc/' + str(pid) + '/exe'))
    if executable != Path('/usr/bin/Hyprland') or not protected_file(executable):
        raise PermissionError('Expected installed compositor is required')
    return display


def environment_for(display, runtime):
    # Never forward caller-controlled DISPLAY, XDG_RUNTIME_DIR, Python/GTK
    # module paths, session-bus addresses, debug variables or credentials.
    return {**ENV, 'HOME': str(runtime), 'XDG_RUNTIME_DIR': str(runtime),
            'WAYLAND_DISPLAY': str(display), 'GDK_BACKEND': 'wayland',
            'DBUS_SESSION_BUS_ADDRESS': 'unix:path=' + str(runtime / 'no-session-bus'),
            'GSETTINGS_BACKEND': 'memory', 'GTK_USE_PORTAL': '0', 'GTK_A11Y': 'none'}


def main():
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    os.umask(0o077)
    if len(sys.argv) != 1 or os.geteuid() != 0:
        return 1
    module = Path('/usr/lib/apollo/owner_account.py')
    if not protected_file(module):
        return 1
    sys.path.insert(0, str(module.parent))
    from owner_account import resolve_owner
    owner = pwd.getpwnam(resolve_owner()['name'])
    if owner.pw_uid == 0:
        return 1
    invoker = os.environ.get('PKEXEC_UID')
    if invoker is not None and invoker != str(owner.pw_uid):
        return 1
    # Missing PKEXEC_UID is accepted only for an already-root trusted
    # maintenance invocation. A user process cannot pass the euid check.
    for name in ('/etc/apollo/native-root-v1', '/var/lib/apollo/owner-ready', PROGRAM,
                 '/usr/lib/apollo/owner-ui/omarchy.css', '/usr/lib/apollo/owner-ui/assets/logo.png'):
        if not protected_file(Path(name)):
            return 1
    display = owner_display(owner.pw_uid)
    runtime = Path('/run/apollo-owner-ui')
    runtime.mkdir(mode=0o700, exist_ok=True)
    info = runtime.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077:
        return 1
    os.chdir(runtime)
    null = os.open('/dev/null', os.O_RDWR | os.O_CLOEXEC)
    for descriptor in (0, 1, 2):
        os.dup2(null, descriptor)
    if null > 2:
        os.close(null)
    os.execve('/usr/bin/python3', ['python3', '-I', PROGRAM, '--change'], environment_for(display, runtime))


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception:
        sys.exit(1)
