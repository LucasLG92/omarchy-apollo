+def open_app_events():
+    """Listen before launch; activation can map outside the exec-rule process."""
+    runtime = os.environ.get("XDG_RUNTIME_DIR")
+    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
+    if not runtime or not signature or "/" in signature:
+        return None
+    stream = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    try:
+        stream.settimeout(0.5)
+        stream.connect(os.path.join(runtime, "hypr", signature, ".socket2.sock"))
+        stream.setblocking(False)
+        return stream
+    except OSError:
+        stream.close()
+        return None
+
+
+def place_new_dbus_app(app_id, entry, before, events, timeout=8):
+    """Fix only a new D-Bus window sharing another app's screen, once.
+
+    D-Bus/systemd activation does not inherit HL_EXEC_RULE_TOKEN. Stop after
+    its first mapped window; future user-requested split layouts are untouched.
+    Read only the event name, then match client class/initialClass as usual.
+    """
+    classes, host = matchers(app_id, entry)
+
+    def place_if_mapped():
+        clients = query("clients")
+        if not isinstance(clients, list):
+            return False
+        fresh = [c for c in clients if isinstance(c, dict)
+                 and norm_address(c.get("address")) not in before
+                 and not c.get("hidden", False)
+                 and not c.get("pinned", False)
+                 and isinstance((c.get("workspace") or {}).get("id"), int)
+                 and c["workspace"]["id"] > 0]
+        window = find_window(fresh, classes, host)
+        if not window:
+            return False
+        address = norm_address(window.get("address"))
+        if not address:
+            return False
+        peers = [c for c in clients if isinstance(c, dict)
+                 and norm_address(c.get("address")) != address
+                 and c.get("mapped", True) and not c.get("hidden", False)
+                 and (c.get("workspace") or {}).get("id") == window["workspace"]["id"]
+                 and not window_matches(c, classes, host)
+                 and str(c.get("class") or "").lower() not in SKIP_CLASSES]
+        if peers and cmd_own_screen([address]) != 0:
+            warn("could not give the newly opened app its own screen")
+        return True
+
+    deadline = time.monotonic() + timeout
+    if place_if_mapped():
+        return
+    pending = b""
+    while time.monotonic() < deadline:
+        try:
+            if not select.select([events], [], [], max(0, deadline - time.monotonic()))[0]:
+                return
+            data = events.recv(16384)
+            if not data:
+                return
+            pending += data
+            if len(pending) > 65536:
+                return
+            lines = pending.split(b"\n")
+            pending = lines.pop()
+            # Do not decode, inspect, store or log event payloads (titles etc.).
+            if any(line.startswith(b"openwindow>>") for line in lines) and place_if_mapped():
+                return
+        except (OSError, ValueError):
+            return
+
