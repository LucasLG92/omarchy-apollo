"""Keep Waydroid's container away from hardware only our drivers may drive.

Waydroid 1.6.3 binds /sys/kernel/debug (rbind, read-write), every /dev/video*
and every /dev/fb* into the container, and chmods /dev/video* and /dev/fb* to
0777 at each container start. On this phone that would give Android's root:
  - debugfs, whose regmap files reach PMU and other registers that crash the
    SoC when read (AGENTS.md: never read PMU registers from userspace);
  - the camera's raw CSIS and sensor nodes (CAMERA-PLAN.md), world-writable;
  - the boot framebuffer.
The container is privileged (no user namespace) and keeps CAP_MKNOD and
CAP_SYS_ADMIN, so it could also make a block device node for the UFS and
undo the storage guard's read-only flag. lxc-omamobile.conf denies every
block device through the cgroup2 device controller.

  omamobile-waydroid-harden patch  [ROOT]  patch Waydroid's Python (pacman hook)
  omamobile-waydroid-harden config [ROOT]  fix the generated LXC config (before
                                           each container start)
  omamobile-waydroid-harden verify [ROOT]  exit 1 unless both are in place

ROOT defaults to /. Every edit is idempotent and refuses a file whose
expected text is missing (a new Waydroid version needs this script checked).
"""
import os
import re
import sys

TAG = "# omamobile-waydroid: "
LXC_PY = "usr/lib/waydroid/tools/helpers/lxc.py"
MANAGER_PY = "usr/lib/waydroid/tools/actions/container_manager.py"
LXC_DIR = "var/lib/waydroid/lxc/waydroid"
HARDEN_INCLUDE = "lxc.include = /usr/share/omamobile-waydroid/lxc-omamobile.conf"

# (file, exact text, what it does)
CUTS = [
    (LXC_PY, '    for n in glob.glob("/dev/fb*"):\n        make_entry(n)\n', "fb nodes"),
    (LXC_PY, '    for n in glob.glob("/dev/graphics/fb*"):\n        make_entry(n)\n', "graphics fb nodes"),
    (LXC_PY, '    for n in glob.glob("/dev/video*"):\n        make_entry(n)\n', "video nodes"),
    (LXC_PY, '    make_entry("/sys/kernel/debug", options="rbind,create=dir,optional 0 0")\n', "debugfs"),
    (MANAGER_PY, '        perm_list.extend(glob.glob("/dev/fb*"))\n', "fb chmod 777"),
    (MANAGER_PY, '        perm_list.extend(glob.glob("/dev/video*"))\n', "video chmod 777"),
    (MANAGER_PY, '            "/sys/kernel/debug/sync/sw_sync",\n', "debugfs sw_sync chmod"),
]

# Lines the generated config_nodes must not carry (an older or unpatched
# generation): debugfs, video and framebuffer binds.
BAD_NODE = re.compile(r"^lxc\.mount\.entry\s*=\s*/(sys/kernel/debug|dev/video\d+|dev/fb\d+|dev/graphics/fb\d+)\s")


def commented(text):
    return "".join(TAG + line.lstrip() + "\n" for line in text.splitlines())


def patch(root):
    ok = True
    for rel in sorted({c[0] for c in CUTS}):
        path = os.path.join(root, rel)
        s = open(path).read()
        new = s
        for f, text, what in CUTS:
            if f != rel:
                continue
            if text in new:
                new = new.replace(text, commented(text), 1)
                print(f"{rel}: removed {what}")
            elif commented(text) in new:
                pass
            else:
                print(f"{rel}: {what}: expected text not found; check this Waydroid version", file=sys.stderr)
                ok = False
        if new != s:
            tmp = path + ".omamobile-tmp"
            with open(tmp, "w") as fh:
                fh.write(new)
            os.chmod(tmp, os.stat(path).st_mode & 0o7777)
            os.replace(tmp, path)
    return ok


# SPDX-License-Identifier: MIT
"""Explicit LXC7 character allowlist; never opens a device."""
from pathlib import Path
import os,re,stat

BASE=Path('/var/lib/waydroid/lxc/waydroid')
INCLUDE='lxc.include = /var/lib/waydroid/lxc/waydroid/config_apollo_devices'
PUBLIC={
    '/dev/null','/dev/zero','/dev/full','/dev/random','/dev/urandom',
    '/dev/tty','/dev/console','/dev/ptmx','/dev/fuse','/dev/net/tun',
    '/dev/sw_sync','/dev/ashmem','/dev/ion','/dev/pmsg0','/dev/uhid',
}

def character_class(value):
    if value in PUBLIC:return 'standard'
    if re.fullmatch(r'/dev/(?:anbox-)?(?:binder|hwbinder|vndbinder)',value):return 'binder'
    if re.fullmatch(r'/dev/dri/renderD[0-9]+',value):return 'DRM-render'
    if re.fullmatch(r'/dev/dma_heap/[A-Za-z0-9_-]+',value):return 'DMA-heap'
    raise ValueError('unreviewed-device-binding')

def policy(root=Path('/')):
    root=Path(root);folder=root/str(BASE)[1:];nodes=folder/'config_nodes'
    rules={(1,3),(1,5),(1,7),(1,8),(1,9),(5,0),(5,1),(5,2)}
    classes={};sources=[]
    for line in nodes.read_text().splitlines():
        if not line.startswith('lxc.mount.entry'):continue
        values=line.split('=',1)[1].strip().split()
        if not values or not values[0].startswith('/dev/'):continue
        source=Path(values[0]);target=root/str(source)[1:]
        try:info=target.stat()
        except FileNotFoundError:continue
        if stat.S_ISBLK(info.st_mode):raise ValueError('block-device-binding-refused')
        if not stat.S_ISCHR(info.st_mode):continue
        kind=character_class(str(source));classes[kind]=classes.get(kind,0)+1
        rules.add((os.major(info.st_rdev),os.minor(info.st_rdev)));sources.append((str(source),info.st_dev,info.st_ino,info.st_rdev))
    if classes.get('binder')!=3 or classes.get('DRM-render')!=1:raise ValueError('Apollo-binder-render-bindings-required')
    text='# Apollo: explicit LXC7 allowlist. No block-device rules are allowed.\n'
    text+='lxc.cgroup2.devices.deny = a\n'
    text+=''.join('lxc.cgroup2.devices.allow = c %d:%d rwm\n'%pair for pair in sorted(rules))
    # Android init creates/writes kmsg; deny reading the host kernel messages.
    text+='lxc.cgroup2.devices.allow = c 1:11 wm\n'
    text+='lxc.cgroup2.devices.allow = c 136:* rwm\n'
    return text,classes,sources

def configure(root=Path('/')):
    root=Path(root);folder=root/str(BASE)[1:];conf=folder/'config';dest=folder/'config_apollo_devices'
    text,classes,sources=policy(root)
    for path in (conf,folder/'config_nodes'):
        info=path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid!=0:raise ValueError('root-owned-regular-config-required')
    if dest.exists() or dest.is_symlink():
        info=dest.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid!=0 or not dest.read_text().startswith('# Apollo: explicit LXC7 allowlist.'):
            raise ValueError('foreign-device-policy-refused')
    # No device opens. Recheck identities immediately before writing the generated policy.
    for path,dev,ino,rdev in sources:
        info=(root/path[1:]).stat()
        if (info.st_dev,info.st_ino,info.st_rdev)!=(dev,ino,rdev):raise ValueError('device-identity-changed')
    tmp=folder/'config_apollo_devices.tmp'
    fd=os.open(tmp,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o644)
    with os.fdopen(fd,'w') as stream:stream.write(text);stream.flush();os.fsync(stream.fileno())
    os.replace(tmp,dest)
    original=conf.read_text();lines=[line for line in original.splitlines() if line!=INCLUDE]
    # Last include resets any earlier policy, then allows only these characters.
    updated='\n'.join(lines)+'\n'+INCLUDE+'\n'
    fd=os.open(conf,os.O_WRONLY|os.O_TRUNC|os.O_NOFOLLOW)
    with os.fdopen(fd,'w') as stream:stream.write(updated);stream.flush();os.fsync(stream.fileno())
    if dest.read_text()!=policy(root)[0] or conf.read_text().splitlines()[-1]!=INCLUDE:raise ValueError('device-policy-verification-failed')
    return classes


def config(root):
    d = os.path.join(root, LXC_DIR)
    nodes = os.path.join(d, "config_nodes")
    conf = os.path.join(d, "config")
    if not os.path.exists(conf):
        print(f"{conf}: missing; run 'waydroid init' first", file=sys.stderr)
        return False
    if os.path.exists(nodes):
        lines = open(nodes).read().splitlines(keepends=True)
        kept = [l for l in lines if not BAD_NODE.match(l)]
        if len(kept) != len(lines):
            with open(nodes, "w") as fh:
                fh.writelines(kept)
            print(f"{nodes}: dropped {len(lines) - len(kept)} hardware binds")
    s = open(conf).read()
    if HARDEN_INCLUDE not in s.splitlines():
        with open(conf, "a") as fh:
            fh.write(("" if s.endswith("\n") else "\n") + HARDEN_INCLUDE + "\n")
        print(f"{conf}: added the omamobile device rules")
    configure(Path(root))
    return True


def verify(root):
    ok = True
    for rel, text, what in CUTS:
        if text in open(os.path.join(root, rel)).read():
            print(f"FAIL {rel}: {what} still active")
            ok = False
    d = os.path.join(root, LXC_DIR)
    nodes = os.path.join(d, "config_nodes")
    if os.path.exists(nodes):
        for l in open(nodes):
            if BAD_NODE.match(l):
                print(f"FAIL {nodes}: {l.strip()}")
                ok = False
    conf = os.path.join(d, "config")
    if not os.path.exists(conf) or HARDEN_INCLUDE not in open(conf).read().splitlines():
        print(f"FAIL {conf}: no omamobile device rules")
        ok = False
    generated = Path(root) / str(BASE)[1:] / "config_apollo_devices"
    if not generated.is_file() or generated.read_text() != policy(Path(root))[0] or open(conf).read().splitlines()[-1] != INCLUDE:
        ok = False
    if ok:
        print("ok    Waydroid hardened")
    return ok


def main():
    if len(sys.argv) not in (2, 3) or sys.argv[1] not in ("patch", "config", "verify"):
        raise SystemExit(__doc__.split("\n\n")[3])
    root = sys.argv[2] if len(sys.argv) == 3 else "/"
    fn = {"patch": patch, "config": config, "verify": verify}[sys.argv[1]]
    sys.exit(0 if fn(root) else 1)


if __name__ == "__main__":
    main()
