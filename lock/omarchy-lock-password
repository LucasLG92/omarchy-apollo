#%PAM-1.0
auth       required                    pam_faillock.so preauth silent deny=5 unlock_time=120
auth       [success=2 default=ignore]    pam_exec.so expose_authtok quiet /usr/lib/omarchy/apollo/verify-pin
auth       [success=1 default=bad]       pam_unix.so try_first_pass
auth       [default=die]                pam_faillock.so authfail deny=5 unlock_time=120
auth       required                    pam_faillock.so authsucc
account    include                     system-local-login
